// deano.art Worker (Rev.5): static site in ./public plus the Artist's Entry API.
// Secret required: ARTIST_PIN (set in Cloudflare dashboard > deano-art > Settings > Variables and Secrets).
{
  "name": "deano-art",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // keep variables set in the Cloudflare dashboard when deploying
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "deano-art", "database_id": "ed905625-f78b-4158-9a91-83a5cc5dac45" }
  ]
}
